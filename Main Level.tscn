[node name="Sign3" parent="NPC\'s" unique_id=70064358 instance=ExtResource("8_pu0n7")]
position = Vector2(94, -56.999992)
scale = Vector2(1.9357278, 2.7592902)
lines = Array[String](["How to move:", "Flinging and Sliding!
To charge a Fling press the mouse button down and pull away from the direction you would like to travel.", "The strength can be controlled through distance puilled back.
However, you cannot Fling at full power immediately.", "You must continue to hold the Fling to charge it up. When the arrow stops growing, you have reached full power!", "Sliding:
This is just a horizontal Fling. When Flinging along the ground you will be able to slide rather than fly.", "Tip:
Flinging can be performed mid-air. However, since you also need to charge, it will not be as powerful.", "(try using mid-air Flings to add momentum to a Fling in progress!)"])

[node name="Dark Snail" parent="NPC\'s" unique_id=409809900 instance=ExtResource("6_vjb8f")]
z_index = 2
position = Vector2(17406.994, -1515)
npc_name = "Molloc"
headshot = ExtResource("20_mup3o")
first_talk_lines = Array[String](["Greetings, traveler. It's been quite some time since I have met another brave enough to reach these cliffs.", "Do you seek the holy shell?", "If you do, it is a long and trecherous path... Fraught with perilous heights, ravenous bugs, and unknown terror.", "It seems you lack protection. If you seek advice, head atop the stump over yonder.", "I shall await your return... though I doubt my patience will be rewarded."])
repeat_talk_lines = Array[String](["Oh? Have you come to retire your journey?"])
line_camera_shots = Dictionary[int, NodePath]({
3: NodePath("../Markers/DarkSnail Stump")
})
