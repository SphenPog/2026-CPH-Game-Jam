[node name="Turbo" parent="NPC\'s" unique_id=1414373201 instance=ExtResource("6_vjb8f")]
z_index = -2
position = Vector2(585, -15)
npc_name = "Turbo"
headshot = ExtResource("7_pu0n7")
first_talk_lines = Array[String](["Race you to Snail Town!", "Not that it will be much of a race.", "3", "2", "1", "GO!"])
repeat_talk_lines = Array[String](["Didn't even break a sweat. Wanna see me do it again?", "Just did."])
