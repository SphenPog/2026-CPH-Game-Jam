npc_name = "Pops"
headshot = ExtResource("23_hdydm")
first_talk_lines = Array[String](["Long time no see, Slug.", "Have you been drinking enough? You don't slime like yourself today.", "Be careful out there, and don't listen to those youngins in town."])
repeat_talk_lines = Array[String](["How are you doing? You are always welcome here, feel free to take a rest."])
