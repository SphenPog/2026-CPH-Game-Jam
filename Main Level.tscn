position = Vector2(11574.04, -977)
npc_name = "Youngster"
headshot = ExtResource("13_uqgby")
first_talk_lines = Array[String](["Hey you!
Yeah, you shellless bum.", "Your presence is ruining my aura. This town doesn't need any more slimy brokeies.", "Go back to your bottom feeding life. I've got 15 shells and a ferrari.", "You can't even get one shell. I'd bet my inheritance on it.", "Now get out of my view."])
repeat_talk_lines = Array[String](["Get out of my way, I can smell your breath from here."])
