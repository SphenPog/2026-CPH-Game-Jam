position = Vector2(-433, 552)
npc_name = "Youngster"
headshot = ExtResource("7_sbv6h")
first_talk_lines = Array[String](["WHAT IS THAT", "WHERE DID YOU GET THAT", "DID YOU STEAL THAT FROM ME? THAT LOOKS LIKE IT SHOULD BE MINE", "THAT IS NOT YOURS! THIS IS NOT FAIR!", "YOU CHEATED! CHEATER! CHEATER!", "ILL NEVER GIVE YOU MY INHERITANCE", "*phone rings*", "WHAT", "my... my what.. is going to Slug? MY WHAT IS GOING TO SLUG", "MOOOOOOOOOOOOM NOOOOOOOOOOOOOOOO THEY CHEATED! I SWEAR IT THEY CHEATED ITS NOT THEIR SHELL", "MOOOOOOOOOOOOOOOOOOOOOOOOOOOM", "ILL NEVER FORGIVE YOU SLUG YOU BROKIE BROKE NO SHELL SLIMEY SLUG"])
repeat_talk_lines = Array[String](["...", "...", "do you have any spare change?", "i cant afford my monthly vbucks.", "my allowance was part of my.... your inheritance...", "i hate you."])
voice_sfx = ExtResource("5_0rhrw")
voice_pitch = 2.0

