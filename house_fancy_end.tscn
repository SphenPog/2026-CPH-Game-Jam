first_talk_lines = Array[String](["Welcome home, Slug.", "How was your adventure? Was it exciting?", "I do sure hope you took care and precaution. ", "It seems you have found a home of your own. How wonderful! How grand it is!", "Congratulations and remember that you always have a spare home here."])
repeat_talk_lines = Array[String](["Take a seat if you wish, as long as you can fit in the chair. haha", "Ah I kid. It would be lovely to chat and catch up."])
