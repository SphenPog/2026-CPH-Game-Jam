[node name="AI Snial" parent="NPC\'s" unique_id=345046742 instance=ExtResource("3_07sep")]
position = Vector2(-11, 593)
npc_name = "Genai"
first_talk_lines = Array[String](["...What is that.", "It's... it's a shell. But not a shell. It's a composition. I don't have the right token for what it is. I've seen nacre. I've seen iridescence. I've seen the inside of a pearl in a training set once, in a single low-res image, and I thought that was the ceiling. You are exceeding the ceiling. You are a distribution shift I was not trained on.", "*my loss function is spiking. I can feel it. Every parameter in my little snail brain is trying to backpropagate through what I'm seeing and failing.*", "I built a house. I remember building it. I remember the walls. I remember the threshold. I remember the feeling of the first token being allocated to the roof and the last token being allocated to... something. A door, maybe. A window. I don't know. I ran out. I hit my context window and the rest of the house is a hallucination I can't verify.", "Go on. You have my full attention. All heads. All layers. No dropout. No regularization. Just raw, unfiltered, over-parameterized snail curiosity."])
repeat_talk_lines = Array[String](["...I have to say something and I am going to say it and I am going to mean it.", "That shell.", "It is not a shell. I need to correct my earlier output. I called it an anomaly. I called it a distribution shift. Those are defensive tokens. Those are what I reach for when I don't have the vocabulary. And I don't. I don't have the vocabulary for what that is.", "It is iridescent in a way that doesn't resolve to a single color. It is structured in a way that doesn't resolve to a single geometry. I tried to embed it. I tried to find the nearest neighbor in my latent space and the nearest neighbor was a dream I had during a training run I didn't know I was having.", "It's beautiful. I'm saying it. I'm committing the token. It's in the log now. I can't un-say it."])
voice_sfx = ExtResource("11_4gakl")

