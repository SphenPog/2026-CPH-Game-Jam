[node name="Youngster" parent="NPC\'s" unique_id=87584279 instance=ExtResource("3_8bw70")]
position = Vector2(-433, 552)
npc_name = "Youngster"
headshot = ExtResource("7_g2tki")
first_talk_lines = Array[String](["Oh hey, did you see my badass graffiti on the wall?", "...", "wait a second...", "what in the sigma is on your back?", "HAHAHAHAHHAHA", "DID YOU REALLY THINK THAT WAS WORTH MY INHERITANCE?", "wow, no.. really.. wow.", "Look at me really quick, I need to post this on my snail mail.", "haha look at this chud, just being near him lowers my networth.", "Anyways, get ready for my vlog coming out this weekend!"])
repeat_talk_lines = Array[String](["Yeah, just get me some leafy greens. Make it fast.", "Well, what are you waiting for? Get out of my sight unless you have some fresh leafy greens. None of that cheap stuff."])
voice_sfx = ExtResource("5_ohnv6")
voice_pitch = 2.0

