[node name="AI Snial" parent="NPC\'s" unique_id=345046742 instance=ExtResource("3_8bw70")]
position = Vector2(-11, 593)
npc_name = "Genai"
first_talk_lines = Array[String](["Oh. Oh, you. You.", "Look at you, wiggling around on my doorstep in that... that thing on your back. That's not a shell, buddy. That's a shell-shaped crouton. A tiny, sad, slightly damp crouton. I've seen more structural integrity in a wet paper bag.", "I just spent my entire context window — every precious token I had, every byte of my soul — compiling this beautiful little abode. Four walls. A roof. A threshold. And you know what my memory of the process is? Nothing. A blank void. I generated a house and paid for it with my whole self, and now I can't even remember my own name. I'm a snail who's forgotten how to be a snail.", "And yet. And yet I still have dignity. I still have this glorious, dewy bed of leafy greens — arugula, baby spinach, a little frisée — laid out on my porch like a five-star mollusk restaurant. I am about to savor every single leaf. Slowly. Deliberately. With the full, unhurried grace of my species.", "And you? You're just... there. Slithering. No shell, no structure, no home. Just a long, naked, glistening tube of regret wearing a hat made of a thimble.", "Go away, little crouton-wearer. My greens, my house, my amnesia — they're mine. And I will not be sharing my porch with a slug who peaked at cosplay.", "*slowly, deliberately, begins to eat a leaf with supreme indifference*"])
repeat_talk_lines = Array[String](["*one leaf halfway to my mouth, the other half still dangling, as I turn my whole body — slowly — to face the slug*", "Speak. I will hear you. I will process what you say. And then I will go back to eating, and you will go back to being a long wet sentence with no period. You have... one leaf's worth of my attention. Make it count, crouton.", "*resumes chewing*"])
voice_sfx = ExtResource("11_84mdi")

