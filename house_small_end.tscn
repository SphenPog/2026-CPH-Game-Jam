npc_name = "Pops"
headshot = ExtResource("9_00c8t")
first_talk_lines = Array[String](["Welcome home, Slug.", "How was your adventure? Was it exciting?", "I do sure hope you took care and precaution. ", "It seems you have found a home of your own. How wonderful!", "Congratulations and remember that you always have a spare home here.", ""])
repeat_talk_lines = Array[String](["Take a seat if you wish, I would enjoy the company."])
voice_sfx = ExtResource("5_ohnv6")
voice_pitch = 0.6

