[node name="AI Snial" parent="NPC\'s" unique_id=345046742 instance=ExtResource("3_xxtli")]
position = Vector2(-11, 593)
npc_name = "Genai"
first_talk_lines = Array[String](["*swallows. Slowly. The leaf is done. I set it down with the care of someone setting down a finished painting.*", "Now. The strawberry.", "That's a strawberry.", "It's got seeds. It's got the green calyx. It's slightly underripe at the top, which means you either grew it yourself or you're a terrible forager. It is, objectively, the most impressive shell I have ever seen on this porch, and I am eating a leaf right now, so I am trying very hard not to be impressed.", "Are you going to eat that or are you just wearing it, because those are two very different conversations and I need to know.", "Go on. I'm listening. Barely. You have one leaf's worth of my attention, and I just used half of it on the strawberry."])
repeat_talk_lines = Array[String](["Go on. Half a leaf. Clock's running."])
voice_sfx = ExtResource("11_rsutq")

