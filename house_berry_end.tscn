[node name="Turbo" parent="NPC\'s" unique_id=92873943 instance=ExtResource("3_xxtli")]
z_index = -1
position = Vector2(315, 598)
npc_name = "Turbo"
headshot = ExtResource("4_wd1nx")
first_talk_lines = Array[String](["Hey dude, rad color choice.", "Does that thing make you any faster?", "Looks pretty fast.", "We should again race sometime. I want to test your new shell out."])
repeat_talk_lines = Array[String](["Yeah, just let me know when you want to go for a race.", "Not that I think you could beat me.", "hah", "beat me...", "rediculous."])
