[node name="Pops" parent="NPC\'s" unique_id=1859109014 instance=ExtResource("3_xxtli")]
position = Vector2(1572, 549)
npc_name = "Pops"
headshot = ExtResource("9_037f2")
first_talk_lines = Array[String](["Welcome home, Slug.", "How was your adventure? Was it exciting?", "I do sure hope you took care and precaution. ", "It seems you have found a home of your own. How wonderful! It looks quite sweet.", "Congratulations and remember that you always have a spare home here."])
repeat_talk_lines = Array[String](["Take a seat if you wish, that would be BERRY nice."])
voice_sfx = ExtResource("5_w6pp1")
voice_pitch = 0.6

