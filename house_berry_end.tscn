[node name="Youngster" parent="NPC\'s" unique_id=87584279 instance=ExtResource("3_xxtli")]
position = Vector2(-433, 552)
npc_name = "Youngster"
headshot = ExtResource("7_5xj51")
first_talk_lines = Array[String](["You do realize you are wearing my literal breakfast, right?", "I know that may have seemed valuable to you. But I can assure you that it is not.", "That is an everyday, plain, bland meal. Anyone with real status would know that.", "And no, it is not a shell. You do not get any of my inheretance."])
repeat_talk_lines = Array[String](["Hey, at least I can't smell your breath since you are wearing food.", "Loser."])
voice_sfx = ExtResource("5_w6pp1")
voice_pitch = 2.0

